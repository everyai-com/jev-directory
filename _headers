# Cloudflare Pages headers. Every page advertises the agent index
# (llmstxt.org v2 discovery) as an HTTP Link header, mirroring the
# <link rel="describedby"> tags in the HTML heads.
/*
  Link: </llms.txt>; rel="describedby"
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
